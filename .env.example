# Lokal: Supabase dev bazasi (Session pooler URI)
DATABASE_URL=postgresql://postgres.xxxx:PAROL@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
# Server (docker-compose): Postgres paroli
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Telegram bot (@BotFather)
TELEGRAM_BOT_TOKEN=
# 2FA majburiyligi (CORE-05). Faqat dev/testda false qilish mumkin; prodda yozmang yoki true
KAFT_REQUIRE_2FA=true
