{
  "name": "kaft",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @kaft/db generate",
    "db:migrate": "pnpm --filter @kaft/db migrate"
  }
}
